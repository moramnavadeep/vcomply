# --- Frontend (read by Vite at build time) ---
# URL of the Niyam API. Leave unset to build a local-only app with no sign-in.
# In development the app falls back to http://localhost:8787.
VITE_API_URL=

# --- API server (read by server/index.ts) ---
PORT=8787
# Postgres connection string. Leave unset in development to use the in-memory store.
DATABASE_URL=
# Set to true when the database requires TLS (external connection strings).
DATABASE_SSL=false
# Long random string used to sign session tokens. Required in production.
JWT_SECRET=
# Comma-separated browser origins allowed to call the API. Empty allows any origin (development only).
ALLOWED_ORIGINS=
